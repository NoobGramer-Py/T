# T — AI Core Configuration
# Copy this file to .env and fill in your keys

# ── AI Providers ──────────────────────────────────────────────────────────────
# Groq API key (primary LLM — free tier available at console.groq.com)
GROQ_API_KEY=gsk_...

# Ollama model for offline fallback (default: llama3.2)
OLLAMA_MODEL=llama3.2

# ── Optional API Keys ─────────────────────────────────────────────────────────
# AbuseIPDB — IP reputation checks (free at abuseipdb.com/api)
ABUSEIPDB_API_KEY=

# VirusTotal — URL/file safety (free at virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# HaveIBeenPwned — breach checks (key at haveibeenpwned.com/API/Key)
HIBP_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Brain WebSocket host/port (change only if port 7891 is in use)
BRAIN_HOST=127.0.0.1
BRAIN_PORT=7891
